<% content_for :title, "Projects" %>

<h1>Projects</h1>

<table class="table table-striped table-bordered table-hover">
  <thead>
    <tr>
      <th>Project Details</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody id="projects">
    <% @projects.each do |project| %>
      <tr>
        <td><%= project.Project_name %></td>
        <td>
          <%= link_to "Show", project, class: "btn btn-info" %>

          <% if project.creator == current_user || current_user.has_role?(:admin) %>
            <%= link_to "Edit", edit_project_path(project), class: "btn btn-success" %> | 
            <%= button_to "Destroy", project, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "New project", new_project_path, class: "btn btn-primary" %>
