<tr id="<%= dom_id project %>">
  <td>
    <strong><%= project.project_name %></strong>
    <br>
    <%= project.project_description %>
  </td>
  <td>
    <% unless current_page?(project_path(project)) %>
      <%= link_to "Show this project", project, class: "btn btn-success" %>
    <% end %>
  </td>
</tr>
