<% content_for :title, "Editing project" %>

<h1>Editing project</h1>

<% if @project.creator == current_user || current_user.has_role?(:admin) %>
  <%= render "form", project: @project %>

  <br>

  <div>
  <%= link_to "Show this project", @project, class: "btn btn-success", style: "margin-right: 10px;" %>
  <%= link_to "Back to projects", projects_path, class: "btn btn-secondary" %>
  
  </div>
<% else %>
  <p class="alert alert-danger">You are not authorized to edit this project.</p>
  <%= link_to "Back to projects", projects_path, class: "btn btn-secondary" %>
<% end %>
