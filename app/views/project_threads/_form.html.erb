<%= form_with(model: [@project, @project_thread], local: true) do |form| %>
  <% if @project_thread.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(@project_thread.errors.count, "error") %> prohibited this thread from being saved:</h2>
      <ul>
        <% @project_thread.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Thread Title", style: "display: block" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <br/>

  <div>
    <%= form.submit "Save Thread", class: "btn btn-primary" %>
  </div>
<% end %>
