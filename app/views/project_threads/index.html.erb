<% content_for :title, "Threads" %>

<h1>Threads</h1>

<% if @threads.present? %>
  <div id="threads">
    <% @threads.each do |thread| %>
      <%= render partial: "project_threads/thread", locals: { thread: thread } %>
      <p>
        <%= link_to "Show this thread", project_project_thread_path(@project, thread) %>
      </p>
    <% end %>
  </div>
<% else %>
  <p>No threads available for this project.</p>
<% end %>

<% if current_user.has_role?(:admin) %>
  <%= link_to "New Thread", new_project_project_thread_path(@project), class: "btn btn-primary" %>
<% end %>
