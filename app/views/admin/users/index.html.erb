<div class="container mt-5">
  <h1 class="mb-4">Admin User Management</h1>

  <table class="table table-striped table-hover table-bordered">
    <thead class="thead-dark">
      <tr>
        <th>Email</th>
        <th>Roles</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.email %></td>
          <td><%= user.roles.map(&:name).join(', ') %></td>
          <td>
            <% if user.has_role?(:admin) %>
              <%= button_to "Demote to User", update_role_admin_user_path(user), method: :patch, params: { role: "user" }, class: "btn btn-danger btn-sm" %>
            <% else %>
              <%= button_to "Make Admin", update_role_admin_user_path(user), method: :patch, params: { role: "admin" }, class: "btn btn-success btn-sm" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
