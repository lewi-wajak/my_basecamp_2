<h1>Edit User</h1>

<%= form_with model: @user, url: admin_user_path(@user), method: :patch do |f| %>
  <div>
    <%= f.label :email %>
    <%= f.text_field :email, disabled: true %>
  </div>

  <div>
    <%= f.label :roles %>
    <%= f.select :role, ["user", "admin"], selected: @user.roles.first.name %>
  </div>

  <div>
    <%= f.submit "Update User" %>
  </div>
<% end %>
